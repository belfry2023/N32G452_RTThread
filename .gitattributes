# 统一换行符, 避免 Windows / Linux 协作时整个文件被判为"已修改"
* text=auto

# Keil 工程文件用 CRLF (uVision 自己写出来就是 CRLF)
*.uvprojx   text eol=crlf
*.uvproj    text eol=crlf
*.sct       text eol=crlf

# 源码与文档统一 LF
*.c         text eol=lf
*.h         text eol=lf
*.s         text eol=lf
*.S         text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.cmake     text eol=lf
CMakeLists.txt text eol=lf

# 二进制资源不要做换行转换
*.pack      binary
*.svd       text eol=lf
*.a         binary
*.bin       binary
*.hex       binary
