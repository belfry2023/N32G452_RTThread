# =============================================================================
#  .gitignore  ——  N32G452 开发工程
#
#  原则:
#    能重新生成的      -> 不入库（构建产物、打包产物、Keil 中间文件）
#    体积大且可获取的  -> 不入库（厂商固件库、LVGL、原始下载包）
#    版权属于厂商的    -> 不入库（数据手册、应用笔记 PDF）
#    其余源码/文档/脚本 -> 入库
#
#  ⚠️ 克隆本仓库后【不能直接编译】, 需先按 README「获取依赖」补齐:
#        Nations.N32G45x_Library.2.6.0/   厂商固件库
#        third_party/lvgl/                LVGL v8.3.11
# =============================================================================

# ---- CMake / GCC 构建产物 ----
build/
dist/
*.o
*.obj
*.d
*.a
*.elf
*.hex
*.bin
*.map
*.lst
*.su
compile_commands.json
.cache/
__pycache__/

# ---- Keil MDK 工程中间产物 ----
#   Objects/ 与 Listings/ 是每个 target 的编译输出, 合计上百 MB
Objects/
Listings/
*.axf
*.htm
*.crf
*.dep
*.lnp
*.iex
*.sct.bak
*.uvguix.*
*.uvoptx
*.bak
*.orig
*.update@*
#
# 注意: RTE/ 目录【保留】—— 那是工程的 Run-Time Environment 配置,
#       含 attr=config 的模板副本 (rtconfig.h / board_config.h / lv_conf.h /
#       gc9307c_panel.h / *.sct), 属于工程的一部分, 不是构建产物。

# ---- 第三方依赖：为「开箱即用」入库, 但只收构建真正用到的部分 ----
#
# 完整 SDK 有 47MB, 其中 projects/(EVAL 例程) 占 32MB, lwIP/FreeRTOS 占 6MB,
# 而 CMake 构建只用到 firmware/ 与 middlewares/rt-thread/。
# 完整 LVGL 有 96MB, 其中 .git 占 26MB、其它 demo 的图片资源占 55MB,
# 而构建只用 src/ 与 demos/{keypad_encoder,stress}。
# 下面的写法是「先全排除, 再逐个放行」—— .gitignore 的目录放行必须逐级声明,
# 所以嵌套看起来啰嗦, 但这是唯一正确的规则。

Nations.N32G45x_Library.2.6.0/*
!Nations.N32G45x_Library.2.6.0/firmware/
!Nations.N32G45x_Library.2.6.0/middlewares/
Nations.N32G45x_Library.2.6.0/middlewares/*
!Nations.N32G45x_Library.2.6.0/middlewares/rt-thread/
# tools/build_pack.py 与 prepare_keil_official.py 要用 LedBlink.uvprojx 当模板
!Nations.N32G45x_Library.2.6.0/projects/
Nations.N32G45x_Library.2.6.0/projects/*
!Nations.N32G45x_Library.2.6.0/projects/n32g45x_EVAL/
Nations.N32G45x_Library.2.6.0/projects/n32g45x_EVAL/*
!Nations.N32G45x_Library.2.6.0/projects/n32g45x_EVAL/examples/
Nations.N32G45x_Library.2.6.0/projects/n32g45x_EVAL/examples/*
!Nations.N32G45x_Library.2.6.0/projects/n32g45x_EVAL/examples/GPIO/
Nations.N32G45x_Library.2.6.0/projects/n32g45x_EVAL/examples/GPIO/*
!Nations.N32G45x_Library.2.6.0/projects/n32g45x_EVAL/examples/GPIO/LedBlink/

third_party/lvgl/*
!third_party/lvgl/src/
!third_party/lvgl/lvgl.h
!third_party/lvgl/LICENSE.txt
!third_party/lvgl/README.md
!third_party/lvgl/demos/
third_party/lvgl/demos/*
!third_party/lvgl/demos/lv_demos.h
!third_party/lvgl/demos/keypad_encoder/
!third_party/lvgl/demos/stress/

# 原始下载包与已解压的 J-Link 补丁不入库（可重新下载）
zip/
jlink_patch/

# ---- 版权属于厂商的资料 ----
#   数据手册 / 应用笔记由国民技术发布, 不适合转存到个人仓库;
#   需要时从厂商官网下载, 文件名见 README 的文档索引。
docs/*.pdf
docs/*.PDF

# ---- 编辑器 / 系统 ----
.vs/
*.user
Thumbs.db
desktop.ini
