# Validate the linked ELF, failing closed on missing tools, symbols or sections.
cmake_minimum_required(VERSION 3.25)
foreach(arg ELF OBJDUMP NM READELF FLASH_ORIGIN FLASH_LEN RAM_ORIGIN RAM_LEN RAM_TOTAL_LEN)
    if(NOT DEFINED ${arg} OR "${${arg}}" STREQUAL "")
        message(FATAL_ERROR "verify_link: missing ${arg}")
    endif()
endforeach()
if(NOT EXISTS "${ELF}")
    message(FATAL_ERROR "verify_link: missing ELF ${ELF}")
endif()
function(read_tool output)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE result ERROR_VARIABLE error)
    if(NOT "${rc}" STREQUAL "0" OR result STREQUAL "")
        message(FATAL_ERROR "verify_link: tool failed (${rc}): ${ARGN}\n${error}")
    endif()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()
macro(check label)
    if(NOT (${ARGN}))
        message(FATAL_ERROR "verify_link: ${label}")
    endif()
    math(EXPR passes "${passes}+1")
    message(STATUS "[PASS] ${label}")
endmacro()
set(passes 0)
read_tool(headers "${OBJDUMP}" -h "${ELF}")
read_tool(symbols "${NM}" --defined-only "${ELF}")
read_tool(elf_header "${READELF}" -h "${ELF}")
read_tool(sections "${READELF}" -SW "${ELF}")
check("ELF32 little-endian ARM executable" elf_header MATCHES "Class: +ELF32" AND elf_header MATCHES "Data: +2's complement, little endian" AND elf_header MATCHES "Machine: +ARM" AND elf_header MATCHES "Type: +EXEC")
if(NOT elf_header MATCHES "Entry point address: +(0x[0-9a-fA-F]+)")
    message(FATAL_ERROR "verify_link: cannot parse ELF entry")
endif()
math(EXPR entry "${CMAKE_MATCH_1}")
string(REPLACE "\n" ";" lines "${symbols}")
foreach(line IN LISTS lines)
    if(line MATCHES "^([0-9a-fA-F]+) +[A-Za-z] +([^ \r]+)")
        set(name "${CMAKE_MATCH_2}")
        math(EXPR sym_${name} "0x${CMAKE_MATCH_1}")
    endif()
endforeach()
foreach(name _estack _sidata _sdata _edata _sbss _ebss Reset_Handler
    g_pfnVectors __vector_start __vector_end __StackTop __StackLimit
    __newlib_heap_start __newlib_heap_end __static_ram_end __rt_heap_start __rt_heap_end
    __flash_image_end _Min_Heap_Size _Min_Stack_Size __rt_init_start __rt_init_end
    __fsymtab_start __fsymtab_end __rt_init_desc_rti_start __rt_init_desc_rti_board_start
    __rt_init_desc_rti_board_end __rt_init_desc_rti_end)
    if(NOT DEFINED sym_${name})
        message(FATAL_ERROR "verify_link: missing symbol ${name}")
    endif()
endforeach()
check("All startup and memory-boundary symbols present" TRUE)
string(REPLACE "\n" ";" lines "${headers}")
set(section_names "")
foreach(line IN LISTS lines)
    if(line MATCHES "^ *[0-9]+ +([^ ]+) +([0-9a-fA-F]+) +([0-9a-fA-F]+) +([0-9a-fA-F]+) +([0-9a-fA-F]+) +")
        set(name "${CMAKE_MATCH_1}")
        set(size "0x${CMAKE_MATCH_2}")
        set(vma "0x${CMAKE_MATCH_3}")
        set(lma "0x${CMAKE_MATCH_4}")
        set(offset "0x${CMAKE_MATCH_5}")
        string(MAKE_C_IDENTIFIER "${name}" id)
        foreach(field size vma lma offset)
            math(EXPR sec_${id}_${field} "${${field}}")
        endforeach()
        list(APPEND section_names "${name}")
    elseif(line MATCHES "^[ ]+(CONTENTS|ALLOC|READONLY|DEBUGGING)")
        set(sec_${id}_flags "${line}")
    endif()
endforeach()
foreach(name .isr_vector .text .data .bss .msp_stack .rt_heap .rti_fn .fsymtab)
    if(NOT name IN_LIST section_names)
        message(FATAL_ERROR "verify_link: missing section ${name}")
    endif()
endforeach()
check("All mandatory sections present" TRUE)
math(EXPR flash_end "${FLASH_ORIGIN}+${FLASH_LEN}")
math(EXPR low_ram_end "${RAM_ORIGIN}+${RAM_LEN}")
math(EXPR ram_end "${RAM_ORIGIN}+${RAM_TOTAL_LEN}")
math(EXPR reset_thumb "${sym_Reset_Handler}|1")
check("Entry equals Reset_Handler with Thumb bit" entry EQUAL reset_thumb)
math(EXPR alignment "${sec__isr_vector_vma}&511")
math(EXPR vector_end "${sec__isr_vector_vma}+${sec__isr_vector_size}")
check("Vector table at Flash origin, 512-byte alignment, 102 entries" sec__isr_vector_vma EQUAL FLASH_ORIGIN AND alignment EQUAL 0 AND sec__isr_vector_size EQUAL 408 AND sym_g_pfnVectors EQUAL FLASH_ORIGIN AND sym___vector_start EQUAL FLASH_ORIGIN AND sym___vector_end EQUAL vector_end)
# Read real file bytes: objdump addresses omit leading zeros, and displayed
# words need byte reversal before interpreting them as little-endian integers.
file(READ "${ELF}" vector_hex OFFSET ${sec__isr_vector_offset} LIMIT 408 HEX)
string(LENGTH "${vector_hex}" vector_hex_length)
check("Complete vector bytes read from ELF" vector_hex_length EQUAL 816)
foreach(index RANGE 0 101)
    math(EXPR position "${index}*8")
    string(SUBSTRING "${vector_hex}" ${position} 8 word)
    string(SUBSTRING "${word}" 0 2 b0)
    string(SUBSTRING "${word}" 2 2 b1)
    string(SUBSTRING "${word}" 4 2 b2)
    string(SUBSTRING "${word}" 6 2 b3)
    math(EXPR vector_${index} "0x${b3}${b2}${b1}${b0}")
    if(index GREATER 0 AND NOT vector_${index} EQUAL 0)
        math(EXPR thumb "${vector_${index}}&1")
        if(NOT thumb EQUAL 1 OR vector_${index} LESS vector_end OR NOT vector_${index} LESS flash_end)
            message(FATAL_ERROR "verify_link: vector ${index} is not a Flash Thumb handler")
        endif()
    endif()
endforeach()
check("Initial SP equals reserved MSP top" vector_0 EQUAL sym___StackTop AND vector_0 EQUAL sym__estack)
check("Reset vector equals ELF entry" vector_1 EQUAL entry)
check("All nonzero handler vectors point into Flash with Thumb bit" TRUE)
foreach(pair "3:HardFault_Handler" "14:PendSV_Handler" "15:SysTick_Handler" "53:USART1_IRQHandler" "56:EXTI15_10_IRQHandler" "70:TIM6_IRQHandler")
    string(REPLACE ":" ";" parts "${pair}")
    list(GET parts 0 index)
    list(GET parts 1 name)
    if(NOT DEFINED sym_${name})
        message(FATAL_ERROR "verify_link: missing interrupt handler ${name}")
    endif()
    math(EXPR expected "${sym_${name}}|1")
    check("Vector ${index} selects ${name}" vector_${index} EQUAL expected)
endforeach()
math(EXPR data_end "${sec__data_vma}+${sec__data_size}")
math(EXPR data_image_end "${sec__data_lma}+${sec__data_size}")
math(EXPR bss_end "${sec__bss_vma}+${sec__bss_size}")
math(EXPR startup_alignment "(${sym__sdata}|${sym__edata}|${sym__sbss}|${sym__ebss})&3")
check("Startup data symbols match RAM VMA and Flash LMA" sym__sdata EQUAL sec__data_vma AND sym__edata EQUAL data_end AND sym__sidata EQUAL sec__data_lma AND NOT sec__data_vma EQUAL sec__data_lma)
check("Startup BSS symbols match section boundaries" sym__sbss EQUAL sec__bss_vma AND sym__ebss EQUAL bss_end)
check("Startup copy/clear ranges are ordered and word aligned" startup_alignment EQUAL 0 AND sym__sdata LESS_EQUAL sym__edata AND sym__edata LESS_EQUAL sym__sbss AND sym__sbss LESS_EQUAL sym__ebss)
foreach(name bss msp_stack rt_heap)
    check(".${name} is NOBITS (no bytes in Flash image)" sections MATCHES "\\.${name} +NOBITS")
endforeach()
check("Flash load image end includes all initialized data" sym___flash_image_end EQUAL data_image_end AND data_image_end LESS_EQUAL flash_end)
foreach(name IN LISTS section_names)
    string(MAKE_C_IDENTIFIER "${name}" id)
    if(NOT DEFINED sec_${id}_flags)
        message(FATAL_ERROR "verify_link: missing flags for ${name}")
    endif()
    set(vma ${sec_${id}_vma})
    set(lma ${sec_${id}_lma})
    math(EXPR end "${vma}+${sec_${id}_size}")
    if(sec_${id}_flags MATCHES "ALLOC" AND sec_${id}_size GREATER 0)
        if(vma GREATER_EQUAL FLASH_ORIGIN AND end LESS_EQUAL flash_end)
            if(end GREATER sym___flash_image_end)
                message(FATAL_ERROR "verify_link: ${name} exceeds reported Flash image end")
            endif()
        elseif(vma GREATER_EQUAL RAM_ORIGIN AND end LESS_EQUAL ram_end)
            if(NOT name MATCHES "^\\.(data|bss|noinit|msp_stack|rt_heap)$")
                message(FATAL_ERROR "verify_link: unexpected RAM section ${name}; startup does not initialize it")
            endif()
        else()
            message(FATAL_ERROR "verify_link: allocated section ${name} exceeds physical memory")
        endif()
    endif()
    if(sec_${id}_flags MATCHES "LOAD" AND sec_${id}_size GREATER 0)
        math(EXPR end "${lma}+${sec_${id}_size}")
        if(lma LESS FLASH_ORIGIN OR end GREATER flash_end)
            message(FATAL_ERROR "verify_link: load image for ${name} exceeds Flash")
        endif()
    endif()
endforeach()
check("Every allocated section and load image fits physical memory" TRUE)
math(EXPR stack_size "${sym___StackTop}-${sym___StackLimit}")
math(EXPR stack_alignment "(${sym___StackTop}|${sym___StackLimit})&7")
math(EXPR heap_size "${sym___newlib_heap_end}-${sym___newlib_heap_start}")
math(EXPR rt_heap_size "${ram_end}-${low_ram_end}")
check("Static data ends before newlib heap" sym___static_ram_end GREATER_EQUAL sym__ebss AND sym___newlib_heap_start EQUAL sym___static_ram_end)
check("newlib heap has minimum capacity and stops at MSP limit" heap_size GREATER_EQUAL sym__Min_Heap_Size AND sym___newlib_heap_end EQUAL sym___StackLimit)
check("Dedicated MSP reservation matches aligned >=2 KiB stack" stack_size EQUAL sym__Min_Stack_Size AND stack_size GREATER_EQUAL 2048 AND stack_alignment EQUAL 0 AND sec__msp_stack_vma EQUAL sym___StackLimit AND sec__msp_stack_size EQUAL stack_size)
check("MSP top equals RT heap start at low RAM boundary" sym___StackTop EQUAL low_ram_end AND sym___rt_heap_start EQUAL low_ram_end AND sec__rt_heap_vma EQUAL low_ram_end)
check("RT heap ends at physical RAM end including R-SRAM" sym___rt_heap_end EQUAL ram_end AND sec__rt_heap_size EQUAL rt_heap_size)
math(EXPR rti_end "${sec__rti_fn_vma}+${sec__rti_fn_size}")
math(EXPR fsym_end "${sec__fsymtab_vma}+${sec__fsymtab_size}")
math(EXPR descriptor_remainder "${sec__rti_fn_size}%8")
check("RT init descriptors survive GC with correct bounds" sec__rti_fn_size GREATER 0 AND descriptor_remainder EQUAL 0 AND sym___rt_init_start EQUAL sec__rti_fn_vma AND sym___rt_init_end EQUAL rti_end)
check("RT init sentinels retain startup order" sym___rt_init_desc_rti_start EQUAL sym___rt_init_start AND sym___rt_init_desc_rti_start LESS sym___rt_init_desc_rti_board_start AND sym___rt_init_desc_rti_board_start LESS sym___rt_init_desc_rti_board_end AND sym___rt_init_desc_rti_board_end LESS sym___rt_init_desc_rti_end AND sym___rt_init_desc_rti_end LESS sym___rt_init_end)
check("Shell registrations survive GC with correct bounds" sec__fsymtab_size GREATER 0 AND sym___fsymtab_start EQUAL sec__fsymtab_vma AND sym___fsymtab_end EQUAL fsym_end)
math(EXPR static_size "${sym___static_ram_end}-${RAM_ORIGIN}")
math(EXPR flash_size "${sym___flash_image_end}-${FLASH_ORIGIN}")
message(STATUS "IMAGE: Flash=${flash_size} B; static RAM incl. alignment=${static_size} B; newlib capacity=${heap_size} B; MSP=${stack_size} B; RT heap=${rt_heap_size} B")
message(STATUS "verify_link: ${passes} checks passed")
