{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "cmake.exportCompileCommandsFile": true,
  "cmake.environment": {
    "PATH": "C:/msys64/mingw64/bin;${env:PATH}"
  },
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.errorSquiggles": "enabled",
  "C_Cpp.intelliSenseEngine": "default",
  "n32.gdbPath": "C:/msys64/mingw64/bin/gdb-multiarch.exe",
  "n32.jlinkDir": "C:/Program Files/SEGGER/JLink_V932",
  "n32.jlinkDevice": "N32G452VE",
  "files.associations": {
    "*.ld": "linkerscript",
    "*.ld.in": "linkerscript",
    "*.jlink": "plaintext",
    "*.pdsc": "xml",
    "*.svd": "xml"
  },
  "files.exclude": {
    "**/build": true,
    "**/.cache": true
  },
  "search.exclude": {
    "**/build": true,
    "**/*.lst": true,
    "**/*.map": true,
    "**/references": true,
    "**/zip": true
  },
  "[c]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "files.encoding": "utf8",
  "files.eol": "\n"
}
